# Centralized Multi-Service Credentials Vault & Neutral Gateway Configuration

# 1. Server Port & Runtime
PORT=3000
NODE_ENV=production
BACKEND_ONLY=true

# 2. Shared Gateway Secret (Protects endpoints against unauthorized callers)
# Frontend apps send this via `X-App-Secret` or `Authorization: Bearer <token>`
CENTRAL_APP_SECRET=a_long_random_shared_string_to_protect_your_endpoints

# 3. Dynamic CORS Allowed Origins (Comma-separated list of your independent frontend apps)
ALLOWED_ORIGINS=https://dome-2030.web.app,https://dome-2030.firebaseapp.com,http://localhost:5173,http://localhost:3000

# 4. Service 1: Google Gemini AI (Official AI Studio Key)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 5. Service 2: Stripe Payments Secret Key
STRIPE_SECRET_KEY=sk_live_51...

# 6. Service 3: Paystack Payments Secret Key
PAYSTACK_SECRET_KEY=sk_live_...

# 7. Additional Provider Secrets (Optional: for universal proxying)
OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-api03-...
GITHUB_TOKEN=ghp_...

# 8. Database Connection Strings (Optional: Neon / Supabase / Cloud SQL / PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-cool-db-12345.us-east-2.aws.neon.tech/neondb?sslmode=require


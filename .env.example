# Centralized Multi-Service Credentials Vault & Neutral Gateway Configuration

# 1. Server Port & Runtime
PORT=3000
NODE_ENV=production
BACKEND_ONLY=true

# 2. Dynamic CORS Allowed Origins (Comma-separated list of your web & mobile apps)
# Supports: Web Apps, Expo Go, Local Dev, Android APK, and iOS native apps
ALLOWED_ORIGINS=https://dome-2030.web.app,https://dome-2030.firebaseapp.com,http://localhost:5173,http://localhost:3000,exp://,capacitor://localhost,ionic://localhost,https://localhost,http://localhost,file://,app://

# 3. Service 1: Google Gemini AI (Official AI Studio Key)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 4. Service 2: Stripe Payments & Billing Credentials
# Supports Standard Secret Keys, Restricted Access Keys (RAK), and Publishable Keys for Test/Live environments
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_TEST_SECRET_KEY=sk_test_51...
STRIPE_LIVE_SECRET_KEY=sk_live_51...
STRIPE_RESTRICTED_KEY=rk_test_51...
STRIPE_TEST_RESTRICTED_KEY=rk_test_51...
STRIPE_LIVE_RESTRICTED_KEY=rk_live_51...
STRIPE_PUBLISHABLE_KEY=pk_test_51...
STRIPE_TEST_PUBLISHABLE_KEY=pk_test_51...
STRIPE_LIVE_PUBLISHABLE_KEY=pk_live_51...

# 5. Service 3: Paystack Payments Secret Key
PAYSTACK_SECRET_KEY=sk_live_...

# 6. Additional Provider Secrets (Optional: for universal proxying)
OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-api03-...
GITHUB_TOKEN=ghp_...

# 7. Database Connection Strings (Optional: Neon / Supabase / Cloud SQL / PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-cool-db-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
